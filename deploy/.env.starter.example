# Plantilla .env para contenedor Plan Starter
# Copiar a .env.starter y rellenar antes de docker compose up

# Identificación del cliente
CLIENT_SLUG=pixelmotion
STARTER_PORT=8100

# Django
SECRET_KEY=cambiar-por-secret-random-largo-50-chars-minimo
DEBUG=False
ALLOWED_HOSTS=pixelmotion.harmoni.pe,localhost

# Base de datos (DB dedicada por cliente — aislamiento total)
DATABASE_URL=postgresql://harmoni_starter:CAMBIAR_PASS@host.docker.internal:5432/harmoni_pixelmotion

# Redis (compartido — namespace por DB index)
REDIS_URL=redis://host.docker.internal:6379/10
CELERY_BROKER_URL=redis://host.docker.internal:6379/10

# Email (compartido o por cliente)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@harmoni.pe
EMAIL_HOST_PASSWORD=CAMBIAR

# Plan Starter — flags
HARMONI_PLAN=STARTER
HARMONI_MAX_TRABAJADORES=30
HARMONI_MAX_EMPRESAS=1

# Logging
LOG_LEVEL=WARNING

# IA / OpenAI — NO usar en Starter (todas las features IA están bloqueadas)
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
