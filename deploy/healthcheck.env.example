# Config del monitoreo externo de /health/ (deploy/healthcheck_alert.sh).
# Copiar a /opt/harmoni/healthcheck.env (chmod 600) y completar AL MENOS
# un canal. Sin canal configurado el script solo deja log.

# ── Canal Telegram ────────────────────────────────────────────
# Crear bot con @BotFather → token. Chat ID: escribirle al bot y abrir
# https://api.telegram.org/bot<TOKEN>/getUpdates → message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Canal WhatsApp (gateway OpenClaw local) ───────────────────
# Mismo gateway que usa la app (POST /api/sendMessage).
OPENCLAW_URL=http://localhost:19000
OPENCLAW_TOKEN=
# Número destino con código de país, ej: 51999999999
WHATSAPP_TO=
