# =============================================================================
# .env template para cliente Enterprise — ADR-001
# Sustituir variables __VAR__ antes del deploy
#
# Cada cliente tiene SU PROPIA DB y SU PROPIO Redis namespace.
# El Postgres puede ser compartido a nivel de instancia, pero la DB es dedicada.
# =============================================================================

# ── Identificación ─────────────────────────────────────────────────
HARMONI_CLIENT_SLUG=__CLIENT_SLUG__
HARMONI_CLIENT_NAME="__CLIENT_NAME__"
HARMONI_TIER=ENTERPRISE

# ── Django ─────────────────────────────────────────────────────────
SECRET_KEY=__SECRET_KEY__
DEBUG=False
ALLOWED_HOSTS=__CLIENT_SLUG__.harmoni.pe,__CUSTOM_DOMAIN__,localhost

# ── Database (PostgreSQL dedicada por cliente) ────────────────────
DB_NAME=__DB_NAME__
DB_USER=__DB_USER__
DB_PASSWORD=__DB_PASSWORD__
DB_HOST=localhost
DB_PORT=5432

# ── Redis (namespaced por cliente para aislamiento de cache + celery) ────
REDIS_URL=redis://localhost:6379/__REDIS_DB__
CELERY_BROKER_URL=redis://localhost:6379/__REDIS_DB__
CELERY_RESULT_BACKEND=redis://localhost:6379/__REDIS_DB__

# ── Email (cada cliente puede usar su propio SMTP) ───────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=__SMTP_HOST__
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=__SMTP_USER__
EMAIL_HOST_PASSWORD=__SMTP_PASS__
DEFAULT_FROM_EMAIL="__CLIENT_NAME__ <no-reply@__CLIENT_SLUG__.harmoni.pe>"

# ── Sentry / Monitoring (opcional por cliente) ────────────────────
SENTRY_DSN=__SENTRY_DSN__
SENTRY_ENVIRONMENT=enterprise-__CLIENT_SLUG__

# ── Plan + features ───────────────────────────────────────────────
HARMONI_PLAN=ENTERPRISE
HARMONI_BRANDING_ENABLED=True

# ── Storage paths ─────────────────────────────────────────────────
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
LOG_DIR=/app/logs
SNAPSHOT_DIR=/app/snapshots
